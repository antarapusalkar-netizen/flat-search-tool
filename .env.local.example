# Copy this file to .env.local and fill in what you have.
# With none of these set, the app runs on an in-memory mock DB and a
# heuristic (non-LLM) fallback for the soft-preference matching — good for
# local dev, but state resets on every server restart and won't persist
# across serverless invocations in production.

# From your Supabase project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# From https://platform.openai.com/api-keys
OPENAI_API_KEY=

# From https://rapidapi.com/otomo-takozo/api/nobroker-api — subscribe on the free
# tier, then copy the key from the "x-rapidapi-key" header shown in the
# Playground's code snippet. Without this, the flat-search feature falls back
# to a few sample Pune listings so the search UI still works in dev.
RAPIDAPI_KEY=
RAPIDAPI_HOST=nobroker-api.p.rapidapi.com
